<script>
var QUESTIONS=[
 {k:1,key:true,t:"If you finance, do you want the full trade value going down on the purchase?",w:"Her form caps cash at $5,000 beyond the trade. This decides whether the $10k–$20k columns are real or theoretical — and whether she'd rather keep that equity liquid."},
 {k:2,key:true,t:"How many miles a year do you actually drive?",w:"She wrote 10,000. Two older kids in activities usually says otherwise. At $0.20/mile, being wrong by 4k/year is $2,400 at turn-in — enough to erase the lease advantage."},
 {k:3,key:true,t:"Do you need a walkway to the third row, or will a sliding bench do?",w:"Two rear-facing seats plus older kids in back multiple times a week. This is the trim decision — captain's chairs mean EX, not LXS."},
 {k:4,t:"What specifically does your husband dislike about leasing?",w:"Get the actual objection. 'Nothing at the end' and 'mileage limits' need completely different answers."},
 {k:5,t:"Three years — is that firm, or could it stretch to five?",w:"If five is realistic, financing wins clearly and you should say so. Don't sell a lease into a five-year hold."},
 {k:6,t:"Have you pulled a credit app yet? Roughly what's your score?",w:"1.9% and the best money factor are tier-1 only. Every number on this page assumes tier 1."},
 {k:7,t:"Has anyone quoted you on the RAV4 yet?",w:"Form says no. Confirm it — you're setting the anchor rather than beating one."},
 {k:8,t:"Black, dark gray, or navy — which is the real must-have?",w:"Narrows the inventory search. Gray or black interior either way."},
 {k:9,t:"Is anyone else in the decision besides you and your husband?",w:"Cheap question, saves a week."}
];
(function(){
  var box=document.getElementById('qs'),saved={},stat=document.getElementById('qstat');
  try{saved=JSON.parse(localStorage.getItem('katie-q')||'{}')}catch(e){saved={}}
  function save(){try{localStorage.setItem('katie-q',JSON.stringify(saved))}catch(e){}}
  function grow(ta){ta.style.height='auto';ta.style.height=Math.max(38,ta.scrollHeight)+'px'}
  function count(){
    var n=QUESTIONS.filter(function(q){return (saved['q'+q.k]||'').trim()}).length;
    stat.textContent=n?n+' of '+QUESTIONS.length+' answered':'';
  }
  QUESTIONS.forEach(function(q){
    var wrap=document.createElement('div');
    wrap.className='q'+(q.key?' key':'');
    var row=document.createElement('div'); row.className='row';
    var cb=document.createElement('input');
    cb.type='checkbox'; cb.id='qc'+q.k; cb.checked=!!(saved['q'+q.k]||'').trim();
    cb.setAttribute('aria-label','Mark question '+q.k+' answered');
    var d=document.createElement('div'); d.style.flex='1';
    var lab=document.createElement('label'); lab.setAttribute('for','qa'+q.k);
    lab.className='qt'; lab.textContent=q.t;
    if(q.key){var b=document.createElement('span'); b.className='tagk'; b.textContent='KEY'; lab.appendChild(b);}
    var w=document.createElement('span'); w.className='qw'; w.textContent=q.w;
    d.appendChild(lab); d.appendChild(w);
    row.appendChild(cb); row.appendChild(d);
    var ta=document.createElement('textarea');
    ta.id='qa'+q.k; ta.placeholder='Her answer…'; ta.value=saved['q'+q.k]||'';
    ta.addEventListener('input',function(){
      saved['q'+q.k]=ta.value; save(); grow(ta);
      var has=!!ta.value.trim();
      cb.checked=has; wrap.classList.toggle('done',has); count();
    });
    cb.addEventListener('change',function(){
      wrap.classList.toggle('done',cb.checked);
      if(cb.checked && !ta.value.trim()){ta.focus()}
    });
    wrap.classList.toggle('done',!!(saved['q'+q.k]||'').trim());
    wrap.appendChild(row); wrap.appendChild(ta); box.appendChild(wrap);
    requestAnimationFrame(function(){grow(ta)});
  });
  count();

  document.getElementById('copyQ').addEventListener('click',function(){
    var out='KATIE — CARNIVAL CALL NOTES\n'+new Date().toLocaleString('en-US')+'\n\n';
    QUESTIONS.forEach(function(q){
      out+='Q'+q.k+'. '+q.t+'\n   '+((saved['q'+q.k]||'').trim()||'—')+'\n\n';
    });
    var done=function(ok){
      stat.textContent=ok?'Copied to clipboard':'Copy failed — select the text manually';
      setTimeout(count,2600);
    };
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(out).then(function(){done(true)},function(){done(false)});
    }else{
      var t=document.createElement('textarea');
      t.value=out; t.style.position='fixed'; t.style.opacity='0';
      document.body.appendChild(t); t.select();
      var ok=false; try{ok=document.execCommand('copy')}catch(e){}
      document.body.removeChild(t); done(ok);
    }
  });
  document.getElementById('clearQ').addEventListener('click',function(){
    if(!confirm('Clear all answers?'))return;
    saved={}; save();
    QUESTIONS.forEach(function(q){
      var ta=document.getElementById('qa'+q.k), cb=document.getElementById('qc'+q.k);
      ta.value=''; ta.style.height='38px'; cb.checked=false;
      ta.closest('.q').classList.remove('done');
    });
    count();
  });
})();

var TAX=.06625, DOC=599, REG=400, ACQ=650, MF=.00218, N=36, TRADE=17500;
var T={
  LXS:{msrp:42935,price:40500,rv:{10000:.65,15000:.61},cash:1900,name:'LXS'},
  EX :{msrp:45135,price:42600,rv:{10000:.64,15000:.60},cash:1960,name:'EX'}
};
function money(n){return '$'+Math.round(n).toLocaleString('en-US')}
function lease(t,das,mi){
  var d=T[t],res=d.msrp*d.rv[mi],p=500;
  for(var i=0;i<300;i++){
    var ccr=Math.max(das-p-REG,0),
        tx=TAX*(p*N+ccr),
        cap=d.price+DOC+ACQ+tx-d.cash-ccr;
    p=(cap-res)/N+(cap+res)*MF;
  }
  return {pmt:p,res:res,ccr:Math.max(das-p-REG,0)};
}
function amort(P,apr,n){var r=apr/12;return r===0?P/n:P*r/(1-Math.pow(1+r,-n))}
function finance(t,cash,apr,n,trade){
  var d=T[t],taxable=d.price+DOC-trade,
      otd=(d.price+DOC)+taxable*TAX+REG-trade,
      P=Math.max(otd-cash,0);
  return {pmt:amort(P,apr,n),P:P,otd:otd};
}

var S={trim:'LXS',mi:10000,trade:1,down:3000};
function seg(id,key,cast){
  document.getElementById(id).addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b)return;
    S[key]=cast(b.dataset.v);
    [].forEach.call(this.querySelectorAll('button'),function(x){
      x.setAttribute('aria-pressed',String(x===b));
    });
    render();
  });
}
seg('segTrim','trim',String); seg('segMi','mi',Number); seg('segTr','trade',Number);
var dn=document.getElementById('down');
dn.addEventListener('input',function(){S.down=+dn.value;render()});

function render(){
  document.getElementById('downV').textContent=money(S.down);
  var tr=S.trade?TRADE:0;
  var L=lease(S.trim,S.down,S.mi),
      f48=finance(S.trim,S.down,.019,48,tr),
      f60=finance(S.trim,S.down,.0499,60,tr);
  document.getElementById('vL').textContent=money(L.pmt);
  document.getElementById('sL').textContent=money(S.down+L.pmt+REG)+' drive-off';
  document.getElementById('vF48').textContent=money(f48.pmt);
  document.getElementById('sF48').textContent=money(f48.P)+' financed';
  document.getElementById('vF60').textContent=money(f60.pmt);
  document.getElementById('sF60').textContent=money(f60.P)+' financed';

  var lo=Math.min(L.pmt,f48.pmt,f60.pmt);
  [['oL',L.pmt],['oF48',f48.pmt],['oF60',f60.pmt]].forEach(function(a){
    document.getElementById(a[0]).classList.toggle('win',a[1]===lo);
  });

  document.getElementById('cnote').innerHTML =
    T[S.trim].name+' · residual at '+(S.mi/1000)+'k = <strong>'+money(L.res)+'</strong>'+
    ' · finance out-the-door '+money(f48.otd+tr)+
    (tr?' · trade applied ('+money(TRADE)+' + '+money(TRADE*TAX)+' tax credit)':' · trade sold separately');

  var flag=document.getElementById('cflag'),msg='';
  if(S.trade && L.ccr>5000)
    msg='<b>Don\'t do this on the lease.</b> '+money(L.ccr)+' of cap reduction is unrecoverable if the van is totaled early. Cap lease money down near $3,000 and take the trade as cash.';
  else if(!S.trade && S.down>5000)
    msg='<b>Above her stated limit.</b> Her form caps cash down at $5,000. Confirm with question 1 before quoting this.';
  else if(S.mi===15000 && L.pmt>560)
    msg='<b>Over her $500 ceiling.</b> Drop to LXS or add cash down to get back under.';
  flag.hidden=!msg; flag.innerHTML=msg;
}

(function(){
  var rows='';
  ['LXS','EX'].forEach(function(t){
    [10000,15000].forEach(function(mi){
      var a=lease(t,0,mi),b=lease(t,3000,mi),c=lease(t,5000,mi),
          hi=(t==='LXS'&&mi===10000)?' class="hi"':'';
      rows+='<tr'+hi+'><td>'+t+' · '+(mi/1000)+'k</td>'+
        '<td class="num pay">'+money(a.pmt)+'</td>'+
        '<td class="num pay">'+money(b.pmt)+'</td>'+
        '<td class="num pay">'+money(c.pmt)+'</td>'+
        '<td class="num">'+money(a.res)+'</td></tr>';
    });
  });
  document.getElementById('tLease').innerHTML=rows;

  var f='';
  ['LXS','EX'].forEach(function(t){
    [[48,.019],[60,.0499]].forEach(function(p){
      var hi=(t==='LXS'&&p[0]===48)?' class="hi"':'';
      f+='<tr'+hi+'><td>'+t+' · '+p[0]+'mo @'+(p[1]*100).toFixed(2)+'%</td>';
      [5000,10000,15000,20000].forEach(function(d){
        f+='<td class="num pay">'+money(finance(t,d,p[1],p[0],TRADE).pmt)+'</td>';
      });
      f+='</tr>';
    });
  });
  document.getElementById('tFin').innerHTML=f;
})();

render();
</script>

